{
  "name": "@erennyuksell/uyumsoft-edonusum-unofficial-sdk",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for Uyumsoft e-Donusum SOAP services.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Eren Yuksell",
    "url": "https://github.com/erennyuksell"
  },
  "homepage": "https://github.com/erennyuksell/uyumsoft-edonusum-unofficial-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erennyuksell/uyumsoft-edonusum-unofficial-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/erennyuksell/uyumsoft-edonusum-unofficial-sdk/issues"
  },
  "keywords": [
    "uyumsoft",
    "edonusum",
    "e-donusum",
    "e-fatura",
    "e-arsiv",
    "e-irsaliye",
    "soap",
    "turkey",
    "typescript",
    "unofficial"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:fixtures": "vitest run test/soap-fixtures.test.ts test/endpoint-matrix.test.ts test/security-logging.test.ts",
    "test:watch": "vitest",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "test:live": "npm run test:live:readonly",
    "test:live:readonly": "npm run build && node scripts/live-readonly.mjs",
    "test:live:mutating": "npm run build && node scripts/live-mutating.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@erennyuksell/ubl-tr": "^0.1.0",
    "strong-soap": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
